# EC2（Amazon Linux 2023）でじゃんけんAPIを常駐させるためのsystemdサービス定義。
#
# 配置先: /etc/systemd/system/janken.service
# 配置後:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now janken
#
# 前提:
#   - 実行用ユーザー janken を作成済み（sudo useradd --system --create-home janken）
#   - 稼働用JARを /opt/janken/janken.jar に配置済み
#   - JDK 21 をインストール済み（sudo dnf install -y java-21-amazon-corretto-headless）

[Unit]
Description=Janken API (Spring Boot)
# ネットワークが使える状態になってから起動する
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=janken
Group=janken
WorkingDirectory=/opt/janken

# CORSで許可するオリジン。S3の静的ウェブサイトエンドポイントに合わせて書き換える。
# 末尾に / やパスは付けない。複数指定するときはカンマ区切りにする。
Environment=ALLOWED_ORIGINS=http://REPLACE-ME-BUCKET.s3-website-ap-northeast-1.amazonaws.com
# 日本語のログを文字化けさせないための設定
Environment=LANG=ja_JP.UTF-8

# 実行可能JARを起動する。javaのパスは `which java` で確認した値に合わせる。
ExecStart=/usr/bin/java -jar /opt/janken/janken.jar

# 異常終了したら10秒後に自動で再起動する
Restart=on-failure
RestartSec=10

# 標準出力・標準エラーをjournaldへ送る（journalctl -u janken で確認できる）
StandardOutput=journal
StandardError=journal
SyslogIdentifier=janken

# 学習用の最小限の保護設定
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
